{
  "manifest_version": 3,
  "name": "ChessSkins — Skins for Lichess & Chess.com",
  "version": "2.0.0",
  "description": "A visual catalog of playful chess piece skins for lichess and chess.com — kittens, robots, pirates, 8-bit and more. Applies instantly.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" },
    "default_title": "ChessSkins — choose a piece skin"
  },
  "options_page": "gallery.html",
  "content_scripts": [
    {
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*",
        "*://lichess.com/*",
        "*://*.lichess.com/*",
        "*://www.chess.com/*",
        "*://chess.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["skins/*/skin.css"],
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*",
        "*://lichess.com/*",
        "*://*.lichess.com/*",
        "*://www.chess.com/*",
        "*://chess.com/*"
      ]
    }
  ]
}
